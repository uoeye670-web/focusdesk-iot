# Set PROJECT_ID sama di laptop dan kedua HP
PROJECT_ID=focusdesk_kelompok_07

# Broker MQTT cloud publik untuk contoh belajar
MQTT_HOST=broker.hivemq.com
MQTT_PORT=8883
MQTT_TLS=true
MQTT_WS_URL=wss://broker.hivemq.com:8884/mqtt

# Untuk broker privat saja (jangan commit file .env)
MQTT_USERNAME=
MQTT_PASSWORD=

# Dashboard hanya bisa dibuka dari laptop sendiri
DASHBOARD_PORT=8000

# Pomodoro (menit). Untuk video demo, perpendek misalnya 3 dan 1.
FOCUS_MINUTES=25
BREAK_MINUTES=5
# Pomodoro asli: setelah 4 sesi fokus, istirahat panjang
LONG_BREAK_MINUTES=15
POMODOROS_PER_SET=4

# Kalibrasi ambang (cek angkanya dengan: python -m scripts.check_sensors --role meja)
LUX_LOW=300
LUX_HIGH=1500
DESK_ACTIVE_RMS=0.09
IDLE_SECONDS=180
